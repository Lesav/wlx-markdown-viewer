#include <windows.h>

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
#pragma code_page(1251)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,9,4,0
 PRODUCTVERSION 2,9,4,0
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription", "Markdown lister plugin for Total/Double Commander"
            VALUE "FileVersion", "2.9.4.0"
            VALUE "InternalName", "MarkdownView"
#ifdef _WIN64
            VALUE "OriginalFilename", "MarkdownView.wlx64"
#else
            VALUE "OriginalFilename", "MarkdownView.wlx"
#endif
            VALUE "ProductName", "MarkdownView"
            VALUE "ProductVersion", "2.9.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END
